# Local development. Export these (or use your shell's dotenv) before `uvicorn app.main:app --reload`.
GEMINI_API_KEY=            # leave empty to use the offline fallback parser
GEMINI_MODEL=gemini-3.8-flash
SECRET_KEY=change-me       # required when ENV=production
# DATABASE_URL=postgresql://user:pass@localhost:5432/mediprxn   # unset => SQLite file (DB_PATH)
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=choose-a-strong-one
# DEMO_SEED=1              # load demo doctor/patient/admin on startup (never in production)

# --- PayPal Sandbox (https://developer.paypal.com > Apps & Credentials > Sandbox) ---
PAYPAL_CLIENT_ID=            # public; sent to the browser for the PayPal buttons
PAYPAL_CLIENT_SECRET=        # server only; never commit
# PAYPAL_WEBHOOK_ID=         # from your sandbox webhook (URL: https://YOUR-HOST/paypal/webhook); webhooks are rejected without it
# PAYPAL_CURRENCY=USD        # sandbox accounts usually cannot charge INR
# INR_PER_UNIT=85            # fixed demo exchange rate, rupees per 1 USD
# PLATFORM_FEE_PAISE=4900    # booking fee (Rs 49)
